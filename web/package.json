{
  "name": "realestateteam-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Web app for talking to the RealEstateTeam expert agents (drafts only).",
  "scripts": {
    "build:team": "node scripts/build-team.mjs",
    "dev": "npm run build:team && vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run build:team && npm run typecheck && vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "yaml": "^2.9.1"
  }
}
